fn is_prime(n) { n >= 2 and no_divisor(n, 2) }

fn no_divisor(n, d) {
  if d * d > n { true }
  else if n % d == 0 { false }
  else { no_divisor(n, d + 1) }
}

fn count_primes(i, limit, acc) {
  if i > limit { acc }
  else {
    let acc = if is_prime(i) { acc + 1 } else { acc };
    count_primes(i + 1, limit, acc)
  }
}

fn main() {
  print("primes below 100000:", count_primes(2, 100000, 0));
}
